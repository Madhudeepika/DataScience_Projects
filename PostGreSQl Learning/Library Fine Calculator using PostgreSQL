CREATE OR REPLACE FUNCTION calculate_fine(due_date DATE, return_date DATE)
RETURNS NUMERIC AS $$
DECLARE
    fine NUMERIC := 0;
BEGIN
    IF return_date > due_date THEN
        fine := (return_date - due_date) * 5;
    END IF;
    RETURN fine;
END;
$$ LANGUAGE plpgsql;


-- Output View 
CREATE VIEW test_case_results AS
SELECT 
    id, due_date, return_date,
    calculate_fine(due_date, return_date) AS fine
FROM test_cases;

