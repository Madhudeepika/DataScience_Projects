SELECT b.title, m.name
FROM borrowings br
JOIN books b ON br.book_id = b.book_id
JOIN members m ON br.member_id = m.member_id
WHERE br.return_date IS NULL;

SELECT m.name, COUNT(*) AS books_borrowed
FROM borrowings br
JOIN members m ON br.member_id = m.member_id
GROUP BY m.name;


CREATE VIEW active_borrowings AS
SELECT * FROM borrowings WHERE return_date IS NULL;

CREATE OR REPLACE FUNCTION calculate_fine(due_date DATE, return_date DATE)
RETURNS NUMERIC AS $$
DECLARE
    fine NUMERIC := 0;
    days_late INT;
BEGIN
    IF return_date > due_date THEN
        days_late := return_date - due_date;
        fine := days_late * 5;  -- ₹5 per day
    END IF;
    RETURN fine;
END;
$$ LANGUAGE plpgsql;

SELECT calculate_fine('2025-06-01', '2025-06-10');

CREATE TABLE test_cases (
    id SERIAL PRIMARY KEY,
    due_date DATE,
    return_date DATE
);

